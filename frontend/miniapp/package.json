{
  "name": "alliance-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "异业联盟商城：消费者 + 商户中心（微信小程序 / H5）",
  "templateInfo": {
    "name": "react",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../contracts/p0-api.yaml -o ../shared/schema.d.ts"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "overrides": {
    "webpack": "5.78.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-framework-react": "3.6.34",
    "@tarojs/plugin-platform-h5": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/react": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "3.6.34",
    "openapi-typescript": "^6.7.6",
    "react-refresh": "^0.14.2",
    "typescript": "^5.4.5"
  }
}
